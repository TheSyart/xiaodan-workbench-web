{
  "version": 2,
  "build": {
    "kind": "image",
    "workflow": "serverops-image.yml"
  },
  "runtime": {
    "kind": "compose",
    "services": [
      {
        "name": "web",
        "image": "ghcr.io/thesyart/xiaodan-workbench-web",
        "port": 3210,
        "healthPath": "/health/ready",
        "data": [
          {
            "name": "data",
            "target": "/app/data"
          }
        ]
      }
    ]
  }
}
